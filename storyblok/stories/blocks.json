        "headline": "A closer look at the blocks",
        "headline__i18n__de": "Die Blöcke im Detail",
        "items": [
          {
            "_uid": "blocks-accordion-edit",
            "component": "accordion_item",
            "title": "What can an editor change?",
            "title__i18n__de": "Was kann die Redaktion ändern?",
            "body": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The fields in Storyblok control the content. Editors can reorder sections, update copy, and add any block allowed by the page model."
                    }
                  ]
                }
              ]
            },
            "body__i18n__de": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Die Felder in Storyblok bestimmen den Inhalt. Die Redaktion kann Abschnitte umsortieren, Texte bearbeiten und alle Blöcke hinzufügen, die das Seitenmodell zulässt."
                    }
                  ]
                }
              ]
            }
          },
          {
            "_uid": "blocks-accordion-expand",
            "component": "accordion_item",
            "title": "Does this interaction need JavaScript?",
            "title__i18n__de": "Braucht diese Interaktion JavaScript?",
            "body": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "No. This accordion uses the native HTML details and summary elements. It can be opened with a mouse, touch, or keyboard, even before JavaScript loads."
                    }
                  ]
                }
              ]
            },
            "body__i18n__de": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Nein. Dieses Akkordeon verwendet die nativen HTML-Elemente details und summary. Es lässt sich mit der Maus, per Touchbedienung oder mit der Tastatur öffnen, auch bevor JavaScript geladen ist."
                    }
                  ]
                }
              ]
            }
          }
        ]
