# Preview / draft token from Storyblok space Settings → Access Tokens
STORYBLOK_DELIVERY_API_TOKEN=

# eu | us | ap | ca | cn — match the space region
STORYBLOK_REGION=eu

# draft while building; published for production
STORYBLOK_VERSION=draft

# Shared secret for /api/preview?secret=…&slug=home
STORYBLOK_PREVIEW_SECRET=

# Shared secret for Storyblok publish webhook → /api/revalidate?secret=…
STORYBLOK_REVALIDATE_SECRET=

# npm run storyblok:push only: personal access token (My account → Personal access tokens) and space ID
STORYBLOK_PERSONAL_ACCESS_TOKEN=
STORYBLOK_SPACE_ID=

# /api/lead: HubSpot Hub ID and form GUID; empty keeps the campaign form in demo mode
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=

# Cloudflare Turnstile for the campaign form; HubSpot forwarding requires the secret.
# Local testing: Cloudflare test keys 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
