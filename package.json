{
  "name": "nextstory",
  "version": "0.10.2",
  "private": false,
  "description": "Next.js App Router + Storyblok headless CMS demo",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "changelog:lint": "node scripts/changelog-lint.mjs",
    "brand:render": "node .github/brand/render.mjs",
    "brand:check": "node .github/brand/render.mjs --check",
    "storyblok:types": "node scripts/storyblok-types.mjs",
    "storyblok:types:check": "node scripts/storyblok-types.mjs --check",
    "storyblok:push": "node --env-file-if-exists=.env scripts/storyblok-push.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify:agent-readiness": "node scripts/verify-agent-readiness.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "postinstall": "node scripts/patch-eslint-minimatch.mjs"
  },
  "dependencies": {
    "@storyblok/react": "^7.4.0",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.4",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "overrides": {
    "happy-dom": "^21.0.4",
    "minimatch": "^11.0.1"
  }
}
